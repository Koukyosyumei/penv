// QEMU virt subset with the legacy PLIC and CLINT, one RV64 hart and 512 MiB.
dram: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x20000000

cpu: CPU.RiscV64 @ sysbus
    cpuType: "rv64gc"
    hartId: 0
    timeProvider: clint

clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x02000000
    [0, 1] -> cpu@[3, 7]
    frequency: 10000000

plic: IRQControllers.PlatformLevelInterruptController @ sysbus 0x0c000000
    [0, 1] -> cpu@[11, 9]
    numberOfSources: 95
    numberOfContexts: 2
    prioritiesEnabled: true

uart0: UART.NS16550 @ sysbus 0x10000000
    IRQ -> plic@10
