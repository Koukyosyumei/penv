// STM32F407 Discovery subset for the FreeRTOS UART4 fixture.
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

flash_controller: MTD.STM32F4_FlashController @ {
        sysbus 0x40023C00;
        sysbus new Bus.BusMultiRegistration { address: 0x1FFFC000; size: 0x100; region: "optionBytes" }
    }
    flash: flash

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic
    vectorTableOffset: 0x08000000

uart4: UART.STM32_UART @ sysbus <0x40004C00, +0x100>
    -> nvic@52

can1: CAN.STMCAN @ sysbus <0x40006400, +0x400>
    [0-3] -> nvic@[19-22]

can2: CAN.STMCAN @ sysbus <0x40006800, +0x400>
    [0-3] -> nvic@[63-66]
    master: can1

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    -> nvic@28
    frequency: 16000000
    initialLimit: 0xFFFFFFFF

pwr: Miscellaneous.STM32_PWR @ sysbus 0x40007000

spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.F4
    IRQ->nvic@35

spi2: SPI.STM32SPI @ sysbus 0x40003800
    series: STM32Series.F4
    IRQ->nvic@36
    DMAReceive->dma1@3

spi3: SPI.STM32SPI @ sysbus 0x40003C00
    series: STM32Series.F4
    IRQ->nvic@51

spi1Loopback: SPI.SPILoopback @ spi1
spi2Loopback: SPI.SPILoopback @ spi2
spi3Loopback: SPI.SPILoopback @ spi3

dma1: DMA.STM32DMA @ sysbus 0x40026000
    [0-7] -> nvic@[11-17,47]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x40020800, +0x400>
    numberOfAFs: 16

// The peripherals run without clock gates in this fixture. Accept the hardware
// startup writes to RCC_AHB1ENR, RCC_APB1ENR and RCC_APB2ENR.
rcc: Python.PythonPeripheral @ sysbus 0x40023800
    size: 0x400
    initable: false
    script: '''
if request.Offset in (
    0x30,
    0x40,
    0x44,
):
    request.Value = 0
'''
