// STM32F407 Discovery subset for the FreeRTOS UART4 fixture.
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x100000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 16000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic
    vectorTableOffset: 0x08000000

uart4: UART.STM32_UART @ sysbus <0x40004C00, +0x100>
    -> nvic@52

timer2: Timers.STM32_Timer @ sysbus 0x40000000
    -> nvic@28
    frequency: 16000000
    initialLimit: 0xFFFFFFFF

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x40020800, +0x400>
    numberOfAFs: 16

// UART, GPIO and TIM2 run without clock gates in this fixture. Accept the hardware
// startup writes to RCC_AHB1ENR and RCC_APB1ENR.
rcc: Python.PythonPeripheral @ sysbus 0x40023800
    size: 0x400
    initable: false
    script: '''
if request.Offset in (
    0x30,
    0x40,
):
    request.Value = 0
'''
